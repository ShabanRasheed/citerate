---
/**
 * Sign up. Identical mechanics to sign-in — the difference is only what we say,
 * and that a free scan token can ride along to be claimed on first login.
 */
import Auth from "../layouts/Auth.astro";

const claim = Astro.url.searchParams.get("claim");
const host = Astro.url.searchParams.get("domain");
const siteUrl = import.meta.env.PUBLIC_SITE_URL ?? "https://citerate.com";
---

<Auth title="Create your account">
  <h1 class="auth__title">
    {claim ? "Claim your readout" : "Create your Citerate account"}
  </h1>
  <p class="auth__sub">
    {
      claim
        ? `The scan${host ? ` for ${host}` : ""} is already run. Claiming it keeps the readout, the queries, and the history under your account.`
        : "One email, no password. The free scan runs immediately; the plan decision comes later."
    }
  </p>

  <form class="stack stack--4" method="post" action="/api/auth/request-link" data-lock>
    <input type="hidden" name="signup" value="1" />
    {claim && <input type="hidden" name="claim" value={claim} />}
    <input type="hidden" name="next" value={claim ? `/claim/${claim}` : "/onboarding/domain"} />

    <label class="form-field">
      <span class="t-label">Work email</span>
      <input class="form-field__input" name="email" type="email" required autocomplete="email" autofocus placeholder="you@company.com" />
    </label>

    <label class="form-field">
      <span class="t-label">Name <span class="chart__note">(optional)</span></span>
      <input class="form-field__input" name="name" type="text" autocomplete="name" placeholder="How your team will see you" />
    </label>

    <button class="btn-primary-c btn-primary-c--lg" type="submit" data-busy="Sending…">
      {claim ? "Claim the readout" : "Create account"}
    </button>
  </form>

  <p class="auth__foot">
    Already have an account? <a href="/sign-in">Sign in</a><br />
    By continuing you agree to the <a href={`${siteUrl}/legal/terms`}>terms</a> and
    <a href={`${siteUrl}/legal/privacy`}>privacy policy</a>.
  </p>
</Auth>

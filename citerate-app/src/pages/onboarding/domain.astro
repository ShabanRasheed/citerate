---
/**
 * Onboarding 1 of 3 — the domain. Verification is deliberately not a blocker:
 * we scan first and ask for proof only when the workspace wants private data
 * (Search Console) or a second seat.
 */
import Auth from "../../layouts/Auth.astro";
import { domainsFor } from "../../lib/data";

const env = Astro.locals.runtime.env;
const workspace = Astro.locals.workspace;
const claim = Astro.url.searchParams.get("claim");
const error = Astro.url.searchParams.get("error");
const existing = workspace ? await domainsFor(env, workspace.workspaceId) : [];
---

<Auth title="Add your domain" wide={true}>
  <div class="steps">
    <span class="steps__dot" data-state="current"></span>
    <span class="steps__dot"></span>
    <span class="steps__dot"></span>
    <span>Step 1 of 3 · your domain</span>
  </div>

  <h1 class="auth__title">Which domain are we measuring?</h1>
  <p class="auth__sub">
    One domain to start. We seed 25 queries from your site and your category, then measure each one three times per
    engine — you can edit the list before the first scheduled scan.
  </p>

  {
    error === "taken" && (
      <div class="c-card" style="border-left:3px solid var(--warn);padding:12px 14px">
        <span class="t-data-sm" style="color:var(--warn-ink)">
          That domain is already tracked by another workspace. We've sent a request to join instead — two workspaces
          measuring the same domain would double-count the same runs.
        </span>
      </div>
    )
  }

  <form class="stack stack--4" method="post" action="/api/onboarding/domain" data-lock>
    {claim && <input type="hidden" name="claim" value={claim} />}

    <label class="form-field">
      <span class="t-label">Domain</span>
      <input
        class="form-field__input"
        name="hostname"
        type="text"
        required
        autofocus
        inputmode="url"
        placeholder="yourcompany.com"
      />
      <span class="chart__note">No https://, no www. Subdomains are separate domains on the meter.</span>
    </label>

    <label class="form-field">
      <span class="t-label">Workspace name <span class="chart__note">(optional)</span></span>
      <input class="form-field__input" name="workspaceName" type="text" placeholder={workspace?.name ?? "Your company"} />
    </label>

    <button class="btn-primary-c btn-primary-c--lg" type="submit" data-busy="Setting up…">Continue</button>
  </form>

  {
    existing.length > 0 && (
      <p class="auth__foot">
        Already tracking {existing.map((d) => d.hostname).join(", ")} · <a href="/overview">go to the readout</a>
      </p>
    )
  }
</Auth>

---
/**
 * Sign in. One field, one button. No password, so nothing to forget and nothing
 * for us to leak. The response is identical for known and unknown emails.
 */
import Auth from "../layouts/Auth.astro";

const next = Astro.url.searchParams.get("next") ?? "/overview";
const error = Astro.url.searchParams.get("error");
const googleEnabled = Boolean(import.meta.env.GOOGLE_CLIENT_ID);
const siteUrl = import.meta.env.PUBLIC_SITE_URL ?? "https://citerate.com";
---

<Auth title="Sign in">
  <h1 class="auth__title">Sign in to Citerate</h1>
  <p class="auth__sub">We email a link and a six-digit code. Either one works.</p>

  {
    error && (
      <div class="c-card" style="border-left:3px solid var(--gap);padding:12px 14px">
        <span class="t-data-sm" style="color:var(--gap-ink)">
          {error === "expired"
            ? "That link expired. Links last 15 minutes — here is a fresh one."
            : error === "used"
              ? "That link was already used. Request a new one."
              : "Something went wrong. Try again."}
        </span>
      </div>
    )
  }

  <form class="stack stack--4" method="post" action="/api/auth/request-link" data-lock>
    <input type="hidden" name="next" value={next} />
    <label class="form-field">
      <span class="t-label">Work email</span>
      <input
        class="form-field__input"
        name="email"
        type="email"
        required
        autocomplete="email"
        autofocus
        placeholder="you@company.com"
      />
    </label>

    <label class="row-between" style="gap:12px;align-items:center">
      <span class="stack stack--1">
        <span style="color:var(--ink)">Trust this device for 30 days</span>
        <span class="chart__note">Off means the session ends when you close the browser.</span>
      </span>
      <input class="form-check-input" type="checkbox" name="trust" value="1" style="min-width:20px;min-height:20px" />
    </label>

    <button class="btn-primary-c btn-primary-c--lg" type="submit" data-busy="Sending…">Email me a link</button>
  </form>

  {
    googleEnabled && (
      <>
        <div class="auth__divider">or</div>
        <a class="btn-ghost" href={`/api/auth/google?next=${encodeURIComponent(next)}`} style="text-align:center">
          Continue with Google
        </a>
      </>
    )
  }

  <p class="auth__foot">
    No account yet? <a href="/sign-up">Start with a free scan</a> ·
    <a href={siteUrl}>Back to citerate.com</a>
  </p>
</Auth>

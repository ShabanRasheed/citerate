---
/**
 * Overview — the pane that has to answer "are we cited, and why not" before the
 * user scrolls. Order is deliberate: number, cause, trend, engines, top fixes.
 * Nothing decorative sits above the fold.
 */
import App from "../layouts/App.astro";
import ScoreUnit from "../components/ScoreUnit.astro";
import CauseBar from "../components/CauseBar.astro";
import TrendChart from "../components/TrendChart.astro";
import EngineGrid from "../components/EngineGrid.astro";
import Locked from "../components/Locked.astro";
import { activeDomain, headline, trend, engineBreakdown, fixQueue, usage, latestScan, competitorShare } from "../lib/data";
import { PLANS, type PlanId } from "../lib/plans";
import { pct, relative, causeLabel } from "../lib/format";

const env = Astro.locals.runtime.env;
const workspace = Astro.locals.workspace!;
const plan = workspace.plan as PlanId;
const limits = PLANS[plan];

const domain = await activeDomain(env, workspace.workspaceId, Astro.url.searchParams.get("domain"));
if (!domain) return Astro.redirect("/onboarding/domain", 302);

const [head, rows, engines, fixes, counters, scan, competitors] = await Promise.all([
  headline(env, domain.id),
  trend(env, domain.id, 90),
  engineBreakdown(env, domain.id),
  fixQueue(env, domain.id),
  usage(env, workspace.workspaceId),
  latestScan(env, domain.id),
  competitorShare(env, domain.id, 5)
]);

// Shell chrome reads these.
Astro.locals.usage = counters;
Astro.locals.lastScanAt = scan?.completed_at ?? scan?.created_at ?? null;

const openFixes = fixes.filter((f) => f.state === "open" || f.state === "in_progress").slice(0, 3);
const verified = fixes.filter((f) => f.state === "verified");
const enginesLocked = limits.engines === "all" ? 0 : Math.max(0, 4 - engines.length);
const running = scan?.status === "queued" || scan?.status === "running";
---

<App title="Overview" current="overview" charts={true} crumb={domain.hostname}>
  {
    running && (
      <div class="c-card" style="border-left:3px solid var(--warn);display:flex;align-items:center;justify-content:space-between;gap:16px">
        <span>
          <span class="state-dot state-dot--running"></span>
          Scan in progress — {scan!.queries_done} of {scan!.queries_total} queries measured.
        </span>
        <span class="chart__note">The readout below is the last completed scan.</span>
      </div>
    )
  }

  {
    scan?.status === "partial" && (
      <div class="c-card" style="border-left:3px solid var(--gap)">
        <span class="t-d4">This readout is partial</span>
        <p class="chart__note">
          {scan.queries_done} of {scan.queries_total} queries completed. Missing runs are excluded from the rate rather
          than counted as uncited — the number stays honest, the coverage note says what is missing.
        </p>
      </div>
    )
  }

  <div class="grid-app">
    <div class="col-7">
      <ScoreUnit headline={head} hostname={domain.hostname} engineCount={engines.length || 2} />
    </div>
    <div class="col-5">
      <CauseBar
        causes={head.causes}
        note="Confidence below 0.6 is reported as unexplained, never forced into a cause."
      />
    </div>
  </div>

  <TrendChart
    title="Citation rate over time"
    rows={rows}
    note={`Computed over ${head.runs} runs — 3 per engine per refresh. Movement inside the band is labelled within noise.`}
  />

  <EngineGrid engines={engines} locked={enginesLocked} />

  <div class="grid-app">
    <div class="col-7">
      <section class="c-card">
        <div class="pane-head">
          <h2 class="chart__title">Top fixes</h2>
          <a class="btn-quiet" href="/fixes">Open the Fix Queue →</a>
        </div>

        {
          limits.fixQueue ? (
            <div class="queue-group" style="margin-top:16px">
              {openFixes.length === 0 ? (
                <span class="chart__note">Nothing open. The next scan opens new findings if anything moves.</span>
              ) : (
                openFixes.map((f, i) => (
                  <a class="row-between" href={`/fixes#${f.id}`} style="gap:16px;padding:12px 14px;background:var(--paper);border-radius:var(--r-sm);text-decoration:none">
                    <span style="display:flex;flex-direction:column;gap:4px;min-width:0">
                      <span class="t-data-sm">{String(i + 1).padStart(2, "0")} · {causeLabel(f.cause as never)}</span>
                      <span style="color:var(--ink)">{f.title}</span>
                    </span>
                    <span class={`pill pill--${f.impact === "high" ? "gap" : f.impact === "medium" ? "warn" : ""}`}>{f.impact}</span>
                  </a>
                ))
              )}
              {verified.length > 0 && (
                <span class="chart__note">
                  {verified.length} fix{verified.length > 1 ? "es" : ""} verified by measurement so far.
                </span>
              )}
            </div>
          ) : (
            <div style="margin-top:16px">
              <Locked
                badge="Growth"
                headline="The Fix Queue turns causes into a ranked list with owners"
                detail="Each fix carries the queries it affects, so shipping it produces its own before/after."
              >
                <div class="queue-group">
                  <div class="row-between" style="padding:12px 14px;background:var(--paper);border-radius:var(--r-sm)">
                    <span>Add a comparison table to your highest-intent page</span>
                    <span class="pill pill--gap">high</span>
                  </div>
                  <div class="row-between" style="padding:12px 14px;background:var(--paper);border-radius:var(--r-sm)">
                    <span>Answer the question in the first 60 words on 4 pages</span>
                    <span class="pill pill--warn">medium</span>
                  </div>
                </div>
              </Locked>
            </div>
          )
        }
      </section>
    </div>

    <div class="col-5">
      <section class="c-card">
        <div class="pane-head">
          <h2 class="chart__title">Cited instead of you</h2>
          <a class="btn-quiet" href="/competitors">All competitors →</a>
        </div>

        {
          limits.competitorNames ? (
            <div class="stack stack--4" style="margin-top:16px">
              {competitors.length === 0 ? (
                <span class="chart__note">No competing domain was cited more than once in the last scan.</span>
              ) : (
                competitors.map((c) => (
                  <div class="row-between" style="gap:12px;padding:10px 14px;background:var(--paper);border-radius:var(--r-sm)">
                    <span style="color:var(--ink)">{c.hostname}</span>
                    <span class="t-data">{pct(c.share)}</span>
                  </div>
                ))
              )}
            </div>
          ) : (
            <div style="margin-top:16px">
              <Locked
                badge="Growth"
                headline="See which domains are cited in your place"
                detail="The free readout counts them; naming them is a paid line because it is the part you act on."
              >
                <div class="stack stack--4">
                  {["■■■■■■.com", "■■■■■■■■.io", "■■■■.co"].map((x) => (
                    <div class="row-between" style="padding:10px 14px;background:var(--paper);border-radius:var(--r-sm)">
                      <span>{x}</span><span class="t-data">■■%</span>
                    </div>
                  ))}
                </div>
              </Locked>
            </div>
          )
        }
      </section>
    </div>
  </div>

  <p class="chart__note">
    Method {import.meta.env.PUBLIC_METHOD_VERSION ?? "1.3"} · last measured {relative(Astro.locals.lastScanAt)} ·
    a citation requires a linked URL that resolves to {domain.hostname}. Unlinked brand mentions are reported
    separately and never counted in the rate.
  </p>
</App>

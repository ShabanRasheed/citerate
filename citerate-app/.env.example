# Copy to .env for local work. Bindings come from wrangler.toml via platformProxy.
PUBLIC_SITE_URL=http://localhost:4321
PUBLIC_APP_URL=http://localhost:4322
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# 32+ random bytes. Rotating it invalidates every session.
SESSION_SECRET=dev-only-change-me-0000000000000000

SESSION_TTL_DAYS=30
SESSION_TTL_DAYS_UNTRUSTED=1
MAGIC_LINK_TTL_MINUTES=15

# Email: unset in dev prints the magic link to the console instead of sending.
RESEND_API_KEY=
EMAIL_FROM="Citerate <hello@citerate.com>"

# Billing. Unset keeps the plan card read-only and checkout returns 501.
# PADDLE_PRICE_IDS is the plan→price JSON map — format in api/billing/checkout.ts.
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_ENV=sandbox
PADDLE_PRICE_IDS=

# Google sign-in (Phase 3b path 2) + Search Console OAuth (Phase 10).
# Unset hides the sign-in button and the GSC connect shows "unconfigured".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Mock data for screens whose engine calls belong to the scanner Worker.
USE_ENGINE_MOCKS=true

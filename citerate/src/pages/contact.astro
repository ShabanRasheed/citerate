---
/**
 * Contact — server-rendered because it handles its own POST and needs the
 * request (intent deep-link, Turnstile, D1 write).
 */
export const prerender = false;

import Marketing from "../layouts/Marketing.astro";
import { env, id, now, run } from "../lib/db";
import { verifyTurnstile, clientIp, rateLimit } from "../lib/guard";
import { send, contactNotifyEmail, contactAckEmail } from "../lib/email";

const INTENTS = {
  sales: {
    label: "Sales",
    fieldLabel: "Company domain",
    fieldHint: "company.com",
    msgHint: "Team size, how many queries you'd track, and what you're trying to prove.",
    submit: "Send to sales",
    slaTitle: "What happens next",
    sla:
      "A reply from a human within one business day. If a call makes sense, we'll bring your domain's free scan to it — not a slide deck."
  },
  agency: {
    label: "Agency demo",
    fieldLabel: "Agency + client count",
    fieldHint: "youragency.com · ~15 active clients",
    msgHint: "Roughly how many clients you'd run, and whether white label matters day one.",
    submit: "Book an agency demo",
    slaTitle: "What happens next",
    sla:
      "A 20-minute call within two business days. Bring two client domains — we scan them live and you keep the results either way."
  },
  support: {
    label: "Support",
    fieldLabel: "Workspace or scan URL",
    fieldHint: "app.citerate.com/w/… or scan link",
    msgHint: "What you expected, what happened instead. Screenshots help.",
    submit: "Open a ticket",
    slaTitle: "Response times",
    sla:
      "Paid plans: same business day. Free scans: within two business days. Status of engines and scan queue is on the changelog page."
  },
  security: {
    label: "Security",
    fieldLabel: "Affected surface",
    fieldHint: "e.g. app.citerate.com, api, a report link",
    msgHint: "Describe the issue. Please do not include exploit details here — use the PGP key for that.",
    submit: "Report to security",
    slaTitle: "Disclosure policy",
    sla:
      "Acknowledgment within 24 hours, triage within 72. We credit reporters unless you'd rather stay anonymous. No legal action for good-faith research."
  }
} as const;

type IntentKey = keyof typeof INTENTS;

let status: "idle" | "sent" | "error" = "idle";
let errorMessage = "";

const url = new URL(Astro.request.url);
let intent = (url.searchParams.get("intent") ?? "sales") as IntentKey;
if (!(intent in INTENTS)) intent = "sales";

if (Astro.request.method === "POST") {
  const e = env(Astro);
  const form = await Astro.request.formData();
  const posted = String(form.get("intent") ?? "sales") as IntentKey;
  if (posted in INTENTS) intent = posted;

  const name = String(form.get("name") ?? "").trim();
  const email = String(form.get("email") ?? "").trim();
  const context = String(form.get("context") ?? "").trim();
  const message = String(form.get("message") ?? "").trim();
  const token = String(form.get("cf-turnstile-response") ?? "");
  const ip = clientIp(Astro.request);

  const limit = await rateLimit(e, `contact:${ip ?? "unknown"}`, 5, 3600);

  if (!name || !email || !message) {
    status = "error";
    errorMessage = "Name, email, and a message are required.";
  } else if (!limit.ok) {
    status = "error";
    errorMessage = "Too many submissions from this connection. Try again shortly.";
  } else if (!(await verifyTurnstile(e, token, ip))) {
    status = "error";
    errorMessage = "Verification failed. Reload the page and try again.";
  } else {
    await run(
      e.DB,
      `INSERT INTO contact_requests (id, intent, name, email, context, message, ip, created_at)
       VALUES (?, ?, ?, ?, ?, ?, ?, ?)`,
      id("cnt"),
      intent,
      name,
      email,
      context,
      message,
      ip,
      now()
    );

    const routeTo =
      intent === "support"
        ? e.EMAIL_SUPPORT
        : intent === "security"
          ? e.EMAIL_SECURITY
          : e.EMAIL_SALES;

    await send(e, {
      to: routeTo ?? "hello@citerate.com",
      subject: `[${intent}] ${name}`,
      html: contactNotifyEmail(intent, name, email, context, message),
      replyTo: email
    });
    await send(e, {
      to: email,
      subject: "We received your message",
      html: contactAckEmail(INTENTS[intent].label.toLowerCase(), INTENTS[intent].sla)
    });

    status = "sent";
  }
}

const cfg = INTENTS[intent];
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<Marketing
  title="Contact"
  description="One form, routed on intent — sales, agency demo, support, or security — so it lands with the person who can actually answer."
  noindex={true}
>
  <section class="section section--flush" style="padding-top:72px;padding-bottom:80px">
    <div class="wrap">
      <div style="display:grid;grid-template-columns:minmax(0,1fr) 380px;gap:72px;align-items:start">
        <div class="stack stack--5">
          <div class="stack stack--3">
            <span class="t-label">Contact</span>
            <h1 class="t-d1">What's this about?</h1>
            <p class="t-lead" style="max-width:52ch">
              One form, routed on intent, so it lands with the person who can actually answer.
            </p>
          </div>

          <nav class="pills" aria-label="Contact reason">
            {
              (Object.keys(INTENTS) as IntentKey[]).map((key) => (
                <a
                  class="pill"
                  href={`/contact?intent=${key}`}
                  aria-selected={intent === key ? "true" : "false"}
                >
                  {INTENTS[key].label}
                </a>
              ))
            }
          </nav>

          {
            status === "sent" ? (
              <div class="c-card c-card--accent-cited">
                <span class="t-label" style="color:var(--cited-ink)">Received</span>
                <span class="t-d4">Thanks — that's with the right person.</span>
                <span class="t-sm">{cfg.sla}</span>
                <a class="btn-quiet" href="/#scan">Run a free scan while you wait →</a>
              </div>
            ) : (
              <form class="c-card c-card--lg" method="POST" style="gap:16px">
                <input type="hidden" name="intent" value={intent} />

                {status === "error" && (
                  <p class="scan-form__error" role="alert" style="margin:0">{errorMessage}</p>
                )}

                <div class="grid grid--2" style="gap:14px">
                  <div class="form-field">
                    <label class="form-field__label" for="name">Name</label>
                    <input class="form-field__input" id="name" name="name" type="text" required autocomplete="name" />
                  </div>
                  <div class="form-field">
                    <label class="form-field__label" for="email">Work email</label>
                    <input class="form-field__input" id="email" name="email" type="email" required autocomplete="email" />
                  </div>
                </div>

                <div class="form-field">
                  <label class="form-field__label" for="context">{cfg.fieldLabel}</label>
                  <input class="form-field__input" id="context" name="context" type="text" placeholder={cfg.fieldHint} />
                </div>

                <div class="form-field">
                  <label class="form-field__label" for="message">Message</label>
                  <textarea class="form-field__textarea" id="message" name="message" required placeholder={cfg.msgHint}
                  ></textarea>
                </div>

                <div class="row-between">
                  <span class="turnstile-note">
                    {siteKey && <span class="cf-turnstile" data-sitekey={siteKey} data-size="invisible" />}
                    Protected by Turnstile — invisible to humans
                  </span>
                  <button class="btn-primary-c" type="submit">{cfg.submit}</button>
                </div>
              </form>
            )
          }
        </div>

        <aside class="stack stack--4">
          <div class="c-card">
            <span class="t-label" style="color:var(--cited-ink)">{cfg.slaTitle}</span>
            <span class="t-sm">{cfg.sla}</span>
          </div>

          <div class="c-card">
            <span class="t-label t-label--ink">Direct lines</span>
            <div class="row-between" style="gap:12px">
              <span class="t-sm">Sales</span><span class="t-data-sm">sales@citerate.com</span>
            </div>
            <div class="row-between" style="gap:12px">
              <span class="t-sm">Support</span><span class="t-data-sm">help@citerate.com</span>
            </div>
            <div class="row-between" style="gap:12px">
              <span class="t-sm">Security</span><span class="t-data-sm">security@citerate.com</span>
            </div>
            <span class="figcap">Security reports: PGP key on /security. We acknowledge within 24h.</span>
          </div>

          <div class="c-card c-card--sunk">
            <span class="t-label t-label--ink">Before you write</span>
            <span class="t-sm">
              "Is my drop AI-related?" is answered faster by the <a href="/#scan">free scan</a> than by email —
              it's the first thing we'd run anyway.
            </span>
          </div>
        </aside>
      </div>
    </div>
  </section>
</Marketing>

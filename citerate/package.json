{
  "name": "citerate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "wrangler pages dev ./dist --compatibility-date=2026-07-01",
    "check": "astro check && tsc --noEmit",
    "preflight": "node src/scripts/preflight.mjs",
    "preflight:local": "node src/scripts/preflight.mjs --local",
    "deploy": "pnpm preflight && pnpm build && wrangler pages deploy ./dist --project-name=citerate",
    "deploy:force": "pnpm build && wrangler pages deploy ./dist --project-name=citerate",
    "lint": "eslint . --ext .ts,.astro",
    "format": "prettier --write \"**/*.{ts,astro,scss,json,md,mdx}\"",
    "db:migrate:local": "wrangler d1 migrations apply citerate-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply citerate-db --remote",
    "db:seed:local": "wrangler d1 execute citerate-db --local --file=./infra/seeds/dev.sql",
    "db:studio": "wrangler d1 execute citerate-db --local --command=\"select name from sqlite_master where type='table'\"",
    "scanner:dev": "wrangler dev --config workers/scanner/wrangler.toml",
    "scanner:deploy": "wrangler deploy --config workers/scanner/wrangler.toml",
    "scanner:tail": "wrangler tail citerate-scanner"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/cloudflare": "^12.2.1",
    "@astrojs/mdx": "^4.0.8",
    "@astrojs/rss": "^4.0.11",
    "@astrojs/sitemap": "^3.2.1",
    "astro": "^5.2.5",
    "bootstrap": "^5.3.3",
    "sass": "^1.83.4",
    "typescript": "^5.7.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250204.0",
    "@types/node": "^22.13.1",
    "eslint": "^9.19.0",
    "eslint-plugin-astro": "^1.3.1",
    "pagefind": "^1.3.0",
    "prettier": "^3.4.2",
    "prettier-plugin-astro": "^0.14.1",
    "wrangler": "^3.107.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "sharp", "workerd"]
  }
}

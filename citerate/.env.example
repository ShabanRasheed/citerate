# Local dev only. Production values live in Cloudflare (wrangler secret put).
# `astro dev` reads these via platformProxy; anything PUBLIC_ is exposed to the browser.

PUBLIC_SITE_URL=http://localhost:4321
PUBLIC_APP_URL=http://localhost:4322
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA   # Cloudflare's always-passes test key

# --- server only ---------------------------------------------------------
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
SESSION_SECRET=generate-32-bytes-and-put-it-here

RESEND_API_KEY=re_dev_xxxxxxxx
EMAIL_FROM="Citerate <hello@citerate.com>"
EMAIL_SALES=sales@citerate.com
EMAIL_SUPPORT=help@citerate.com
EMAIL_SECURITY=security@citerate.com

PADDLE_API_KEY=pdl_dev_xxxxxxxx
PADDLE_WEBHOOK_SECRET=pdl_ntfset_xxxxxxxx
PADDLE_ENV=sandbox

# --- engine clients ------------------------------------------------------
# The scanner uses whichever keys are present; missing ones mark that engine "unavailable"
# rather than failing the scan.
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
GEMINI_API_KEY=
SERP_API_KEY=            # Google AI Overviews + organic position evidence

# --- behaviour flags -----------------------------------------------------
FREE_SCAN_QUERY_LIMIT=25
FREE_SCAN_ENGINES=chatgpt,google_aio
FREE_SCAN_CACHE_TTL_SECONDS=86400
RUNS_PER_ENGINE=3
USE_ENGINE_MOCKS=true    # true = no API spend, deterministic fake answers

# Production reads this from workers/scanner/wrangler.toml, not from here.
# Preflight checks the two agree: pnpm preflight / pnpm preflight:local
